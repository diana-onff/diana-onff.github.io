# Scratch directory of kmz2geojson.py — temporarily unpacked KML, not for the repo
.kmz-work/
 
# Compiled Python
__pycache__/
*.py[cod]
 
# Local build directory of site.sh
_site/
 
# The source KMZ has no business in this public repo. It lives in the private
# source repo; the build fetches it from there into bron/.
source/*.kmz
bron/
 
# --- Cloudflare Worker ---
# .dev.vars is where `wrangler dev` keeps secrets for local runs, in PLAIN TEXT.
# It must never be committed. The KV namespace id in wrangler.toml is fine and
# belongs in the repository: it is a reference, not a key, and useless to anyone
# without a token for this Cloudflare account.
.dev.vars
.dev.vars.*
.wrangler/
node_modules/
